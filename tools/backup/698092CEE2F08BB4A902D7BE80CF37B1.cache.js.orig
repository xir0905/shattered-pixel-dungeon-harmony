cssuc.addAllChanges_12 = function addAllChanges_12(changeInfos){
  cssuc.$clinit_v4_X_Changes();
  cssuc.add_Coming_Soon(changeInfos);
  cssuc.add_v4_0_Changes(changeInfos);
