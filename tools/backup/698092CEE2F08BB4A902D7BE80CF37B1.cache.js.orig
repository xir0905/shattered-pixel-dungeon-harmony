cggl.Lcom_shatteredpixel_shatteredpixeldungeon_ui_changelist_v3_1X_1Changes_2_classLit = createForClass('com.shatteredpixel.shatteredpixeldungeon.ui.changelist', 'v3_X_Changes', 2657, cggl.Ljava_lang_Object_2_classLit);
