cssuc.addAllChanges_11 = function addAllChanges_11(changeInfos){
  cssuc.$clinit_v3_X_Changes();
  cssuc.add_v3_3_Changes(changeInfos);
  cssuc.add_v3_2_Changes(changeInfos);
