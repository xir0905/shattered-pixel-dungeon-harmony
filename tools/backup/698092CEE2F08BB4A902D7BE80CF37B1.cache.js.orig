cssuc.addAllChanges_3 = function addAllChanges_3(changeInfos){
  cssuc.$clinit_v0_4_X_Changes();
  var changes;
  changes = new cssuc.ChangeInfo('v0.4.X', true, '');
  changes.hardlight_0(16777028);
  changeInfos.add_21(changes);
