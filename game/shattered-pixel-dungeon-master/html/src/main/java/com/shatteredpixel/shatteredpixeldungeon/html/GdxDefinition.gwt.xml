<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit trunk//EN" "http://www.gwtproject.org/doctype/2.8.0/gwt-module.dtd">
<module rename-to="shattered">
	<inherits name="com.badlogic.gdx.backends.gdx_backends_gwt"/>
	<inherits name="com.badlogic.gdx.controllers.controllers-gwt"/>
	<!-- Game code: package-prefix modules make core/SPD-classes/services/org.json
	     sources visible to GWT via classpath scanning. -->
	<inherits name="com.shatteredpixel.shatteredpixeldungeon.SPDCore"/>
	<inherits name="com.watabou.Watabou"/>
	<inherits name="org.json.JSON"/>

	<entry-point class="com.shatteredpixel.shatteredpixeldungeon.html.HtmlLauncher"/>

	<!-- HarmonyOS ArkWeb is a Chromium engine: it always resolves to the
	     WebKit/Blink (safari) branch of GWT's user.agent deferred binding.
	     Pinning the property collapses the compile from 2 permutations
	     (safari + gecko1_8, ~4.7MB each) to 1, halving rawfile size,
	     install package and first-parse time. If this build is ever also
	     shipped to Firefox-family browsers, remove this. -->
	<set-property name="user.agent" value="safari"/>

	<set-configuration-property name="gdx.assetpath" value="../core/src/main/assets"/>
	<!-- Trailing slash matters: the preloader bundle generator concatenates "assets/" onto this value.
	     Pointing it at the same dir as -war keeps the whole deployable site in build/dist. -->
	<set-configuration-property name="gdx.assetoutputpath" value="build/dist/"/>

	<!-- Reflectable game classes (saves/rankings deserialization etc.) -->
	<extend-configuration-property name="gdx.reflect.include" value="com.shatteredpixel.shatteredpixeldungeon"/>
	<extend-configuration-property name="gdx.reflect.include" value="com.watabou"/>

	<source path="">
		<exclude name="**/emu/**"/>
	</source>
	<super-source path="emu"/>
</module>
